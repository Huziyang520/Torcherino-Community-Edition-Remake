{
    "schemaVersion": 1,
    "id": "torcherino",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/torcherino",
        "sources": "https://github.com/Huziyang520/Torcherino-Community-Edition-Remake",
        "issues": "https://github.com/Huziyang520/Torcherino-Community-Edition-Remake/issues"
    },
    "license": "${license}",
    "icon": "assets/torcherino/torcherino.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.sci.torcherino.TorcherinoFabric"
        ],
        "client": [
            "com.sci.torcherino.client.TorcherinoFabricClient"
        ]
    },
    "depends": {
        "fabricloader": ">=0.16",
        "fabric-api": "*",
        "minecraft": "~1.20.1",
        "java": ">=17"
    },
    "suggests": {
        "projecte": "*"
    }
}
