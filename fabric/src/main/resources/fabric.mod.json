    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contributors": [
        "Scitoshi Nakayobro (original Torcherino)",
        "LukeGrahamLandry (maintainer)",
        "artiks4471 (Community Edition)"
    ],
    "contact": {
        "homepage": "https://github.com/Huziyang520/Torcherino-Community-Edition-Remake",
        "sources": "https://github.com/Huziyang520/Torcherino-Community-Edition-Remake",
        "issues": "https://github.com/Huziyang520/Torcherino-Community-Edition-Remake/issues"
