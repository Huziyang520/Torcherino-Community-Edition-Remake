{
    "schemaVersion": 1,
    "id": "torcherino",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contributors": [
        "Scitoshi Nakayobro (original Torcherino)",
        "LukeGrahamLandry (maintainer)",
        "artiks4471 (Community Edition)"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/torcherino-community-edition-remake",
        "sources": "https://github.com/Huziyang520/Torcherino-Community-Edition-Remake",
        "issues": "https://github.com/Huziyang520/Torcherino-Community-Edition-Remake/issues"
    },
    "custom": {
        "modmenu": {
            "links": {
                "gui.torcherino.link.backupIssue": "https://issue.mengcai.online/"
            }
        }
    },
    "license": "${license}",
    "icon": "assets/torcherino/torcherino.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.sci.torcherino.TorcherinoFabric"
        ],
        "client": [
            "com.sci.torcherino.client.TorcherinoFabricClient"
        ],
        "modmenu": [
            "com.sci.torcherino.client.TorcherinoModMenu"
        ],
        "jade": [
            "com.sci.torcherino.compat.jade.TorcherinoJadeFabricPlugin"
        ]
    },
    "depends": {
        "fabricloader": ">=0.16",
        "fabric-api": "*",
        "minecraft": "~1.20.1",
        "java": ">=17"
    },
    "suggests": {
        "projecte": "*",
        "cloth-config": "*",
        "modmenu": "*"
    }
}
